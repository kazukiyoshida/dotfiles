# Brewfile - packages installed by setup.sh via `brew bundle`
#
#   brew bundle --file=Brewfile
#
# Claude Code and Codex are not here; they use their native installers
# (see setup.sh) so they can self-update.

# --- CLI tools ---------------------------------------------------------------
brew "neovim"
brew "tmux"
brew "fzf"
brew "ripgrep"
brew "tig"
brew "shellcheck"
brew "tailscale"        # OSS CLI + daemon (do not also install the tailscale-app cask)
brew "defaultbrowser"   # used by setup.sh to make Chrome the default browser

# --- Apps --------------------------------------------------------------------
cask "ghostty"
cask "google-chrome"
